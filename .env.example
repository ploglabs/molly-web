# Discord OAuth2 Application
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Exposed to the client for bot invite URLs (usually same as DISCORD_CLIENT_ID)
NEXT_PUBLIC_DISCORD_CLIENT_ID=

# JWT secret for session tokens (generate with: openssl rand -base64 32)
JWT_SECRET=

# Convex deployment URL (set by `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
